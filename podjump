#!/usr/bin/env bash
# Menu-only pod access: every target is picked from a list, nothing is typed.
# Never changes the active kube context or namespace; every kubectl call passes
# --context and -n explicitly.

set -euo pipefail

COMPONENT="api-server"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

cancel() {
  printf 'cancelled, nothing executed.\n' >&2
  exit 130
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

# Reads options from stdin and prints the selection. An empty back label means
# there is no previous step.
choose() {
  local prompt="$1" header="$2" back="$3"
  {
    [[ -n "$back" ]] && printf '%s\n' "$back"
    awk 'NF'
  } | fzf \
    --height=40% \
    --layout=reverse \
    --border \
    --cycle \
    --no-multi \
    --prompt="${prompt}> " \
    --header="${header}"
}

[[ $# -eq 0 ]] || die "podjump takes no arguments. Run: podjump"

require_cmd kubectl
require_cmd fzf

BACK_CLUSTER="<< back: cluster"
BACK_NAMESPACE="<< back: namespace"
BACK_INSTANCE="<< back: instance"
BACK_POD="<< back: pod"

CONTEXT=""
NAMESPACE=""
INSTANCE=""
POD=""
CONTAINER=""
POD_AUTO="false"
CONTAINER_AUTO="false"

step="cluster"

while :; do
  case "$step" in
    cluster)
      contexts="$(kubectl config get-contexts -o name 2>/dev/null)" || die "cannot read kubeconfig contexts"
      [[ -n "$contexts" ]] || die "no contexts found in kubeconfig"
      CONTEXT="$(printf '%s\n' "$contexts" | choose "cluster" "pick a cluster (esc to quit)" "")" || cancel
      step="namespace"
      ;;

    namespace)
      if ! namespaces="$(kubectl --context "$CONTEXT" get namespaces \
        -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>&1)"; then
        printf 'cannot list namespaces in %s:\n%s\n' "$CONTEXT" "$namespaces" >&2
        step="cluster"
        continue
      fi
      choice="$(printf '%s\n' "$namespaces" \
        | choose "namespace" "cluster: ${CONTEXT}" "$BACK_CLUSTER")" || cancel
      if [[ "$choice" == "$BACK_CLUSTER" ]]; then
        step="cluster"
        continue
      fi
      NAMESPACE="$choice"
      step="instance"
      ;;

    instance)
      instances="$(kubectl --context "$CONTEXT" -n "$NAMESPACE" get pods \
        -l "app.kubernetes.io/component=${COMPONENT}" \
        -o jsonpath='{range .items[*]}{.metadata.labels.app\.kubernetes\.io/instance}{"\n"}{end}' \
        2>/dev/null | awk 'NF' | sort -u)" || instances=""
      header="cluster: ${CONTEXT} | namespace: ${NAMESPACE}"
      [[ -n "$instances" ]] || header="${header} | no ${COMPONENT} pods here"
      choice="$(printf '%s\n' "$instances" \
        | choose "instance" "$header" "$BACK_NAMESPACE")" || cancel
      if [[ "$choice" == "$BACK_NAMESPACE" ]]; then
        step="namespace"
        continue
      fi
      INSTANCE="$choice"
      step="pod"
      ;;

    pod)
      pods="$(kubectl --context "$CONTEXT" -n "$NAMESPACE" get pods \
        -l "app.kubernetes.io/component=${COMPONENT},app.kubernetes.io/instance=${INSTANCE}" \
        --field-selector=status.phase=Running \
        -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' \
        2>/dev/null | awk 'NF')" || pods=""
      pod_count="$(printf '%s\n' "$pods" | awk 'NF' | wc -l | tr -d ' ')"

      if [[ "$pod_count" -eq 1 ]]; then
        POD="$pods"
        POD_AUTO="true"
        step="container"
        continue
      fi

      POD_AUTO="false"
      header="cluster: ${CONTEXT} | namespace: ${NAMESPACE} | instance: ${INSTANCE}"
      [[ "$pod_count" -gt 0 ]] || header="${header} | no running pods"
      choice="$(printf '%s\n' "$pods" \
        | choose "pod" "$header" "$BACK_INSTANCE")" || cancel
      if [[ "$choice" == "$BACK_INSTANCE" ]]; then
        step="instance"
        continue
      fi
      POD="$choice"
      step="container"
      ;;

    container)
      containers="$(kubectl --context "$CONTEXT" -n "$NAMESPACE" get pod "$POD" \
        -o jsonpath='{range .spec.containers[*]}{.name}{"\n"}{end}' \
        2>/dev/null | awk 'NF')" || containers=""
      container_count="$(printf '%s\n' "$containers" | awk 'NF' | wc -l | tr -d ' ')"

      if [[ "$container_count" -eq 0 ]]; then
        printf 'pod %s is gone or unreadable, pick again.\n' "$POD" >&2
        step="pod"
        continue
      fi

      if [[ "$container_count" -eq 1 ]]; then
        CONTAINER="$containers"
        CONTAINER_AUTO="true"
        step="confirm"
        continue
      fi

      CONTAINER_AUTO="false"
      if [[ "$POD_AUTO" == "true" ]]; then
        back_label="$BACK_INSTANCE"
      else
        back_label="$BACK_POD"
      fi
      choice="$(printf '%s\n' "$containers" \
        | choose "container" "cluster: ${CONTEXT} | namespace: ${NAMESPACE} | pod: ${POD}" "$back_label")" || cancel
      if [[ "$choice" == "$BACK_INSTANCE" ]]; then
        step="instance"
        continue
      fi
      if [[ "$choice" == "$BACK_POD" ]]; then
        step="pod"
        continue
      fi
      CONTAINER="$choice"
      step="confirm"
      ;;

    confirm)
      {
        printf '\n'
        printf '  cluster   : %s\n' "$CONTEXT"
        printf '  namespace : %s\n' "$NAMESPACE"
        printf '  pod       : %s\n' "$POD"
        printf '  container : %s\n' "$CONTAINER"
        printf '\n'
      } >/dev/tty
      read -r -p "exec into this pod? [y = yes, b = back, anything else = quit]: " answer </dev/tty || cancel
      case "$answer" in
        y|Y)
          break
          ;;
        b|B)
          if [[ "$CONTAINER_AUTO" != "true" ]]; then
            step="container"
          elif [[ "$POD_AUTO" != "true" ]]; then
            step="pod"
          else
            step="instance"
          fi
          ;;
        *)
          cancel
          ;;
      esac
      ;;
  esac
done

exec kubectl --context "$CONTEXT" -n "$NAMESPACE" exec -it "$POD" -c "$CONTAINER" -- \
  sh -c 'if command -v bash >/dev/null 2>&1; then exec bash; else exec sh; fi'
